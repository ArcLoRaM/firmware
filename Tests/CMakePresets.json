{
    "version": 6,
    "configurePresets": [
        {
            "name": "host-mingw",
            "displayName": "Host (MinGW-w64 / MSYS2 UCRT64)",
            "description": "Builds and runs tests on Windows using MinGW GCC. Completely separate from the STM32 firmware build.",
            "generator": "MinGW Makefiles",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "host-mingw",
            "configurePreset": "host-mingw"
        }
    ],
    "testPresets": [
        {
            "name": "host-mingw",
            "configurePreset": "host-mingw",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
